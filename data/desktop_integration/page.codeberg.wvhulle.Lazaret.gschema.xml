<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="page.codeberg.wvhulle.Lazaret" path="/page/codeberg/wvhulle/Lazaret/">
    <key name="show-live-progress" type="b">
      <default>true</default>
    </key>
    <key name="notifications-enabled" type="b">
      <default>true</default>
    </key>
    <key name="close-action" type="s">
      <choices>
        <choice value="quit"/>
        <choice value="minimize"/>
        <choice value="ask"/>
      </choices>
      <default>"ask"</default>
    </key>
    <key name="start-in-background" type="b">
      <default>false</default>
    </key>
    <key name="schedule-enabled" type="b">
      <default>false</default>
    </key>
    <key name="schedule-frequency" type="s">
      <choices>
        <choice value="hourly"/>
        <choice value="daily"/>
        <choice value="weekly"/>
        <choice value="monthly"/>
      </choices>
      <default>"weekly"</default>
    </key>
    <key name="schedule-time" type="s">
      <default>"02:00"</default>
    </key>
    <key name="schedule-day-of-week" type="i">
      <range min="0" max="6"/>
      <default>0</default>
    </key>
    <key name="schedule-day-of-month" type="i">
      <range min="1" max="28"/>
      <default>1</default>
    </key>
    <key name="schedule-targets" type="as">
      <default>[]</default>
    </key>
    <key name="schedule-skip-on-battery" type="b">
      <default>true</default>
    </key>
    <key name="schedule-auto-quarantine" type="b">
      <default>false</default>
    </key>
    <key name="device-scan-enabled" type="b">
      <default>false</default>
    </key>
    <key name="device-scan-max-gigabytes" type="u">
      <default>32</default>
    </key>
    <key name="device-scan-skip-on-battery" type="b">
      <default>true</default>
    </key>
    <key name="scan-backend" type="s">
      <choices>
        <choice value="auto"/>
        <choice value="clamd"/>
        <choice value="clamscan"/>
      </choices>
      <default>"auto"</default>
    </key>
    <key name="exclusion-rules" type="a(ssb)">
      <default>[("node_modules", "directory", true), (".git", "directory", true), (".venv", "directory", true), ("build", "directory", true), ("dist", "directory", true), ("__pycache__", "directory", true)]</default>
    </key>
    <key name="virustotal-key-file" type="s">
      <default>""</default>
      <summary>File holding the VirusTotal API key, provided by the system configuration</summary>
    </key>
    <key name="abuse-ch-key-file" type="s">
      <default>""</default>
      <summary>File holding the abuse.ch Auth-Key, provided by the system configuration</summary>
    </key>
  </schema>
</schemalist>
