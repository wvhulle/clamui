#
# Glossary:
#   scan (verb) = quét; a scan run = lượt quét; scanner = trình quét
#   scan backend (auto / daemon / standalone) = cơ chế quét
#   on-access scanning = quét thời gian thực; scheduled scan = quét theo lịch
#   threat = mối đe dọa; infected = bị nhiễm; clean = sạch
#   quarantine (verb) = cách ly; the quarantine (place/list) = khu cách ly
#   virus definitions / database = cơ sở dữ liệu virus; signatures = chữ ký virus
#   daemon = dịch vụ («dịch vụ clamd», «dịch vụ ClamAV»)
#   exclusions = ngoại lệ; Exclude (button) = Loại trừ
#   mirror / CDN = máy chủ tải xuống
#   file = tệp; folder / directory = thư mục; path = đường dẫn
#   Preferences (the app window) = Tùy chọn; settings (ClamAV/system) = cài đặt
#   profile = hồ sơ quét; log = nhật ký; target = mục tiêu
#   tray / notification area = khay hệ thống
#   host (as opposed to the Flatpak sandbox) = hệ thống chủ (not «máy chủ» = server)
#   keyring = kho khóa; privileged helper = trình trợ giúp đặc quyền
#   administrator rights = quyền quản trị; rate limited = bị giới hạn tạm thời
#   audit = kiểm tra bảo mật; firewall = tường lửa
#
# Tool, product, file and command names are never translated (ClamAV, clamd,
# clamscan, clamdscan, clamonacc, freshclam, Flatpak, VirusTotal, …), and
# "Scan with ClamUI" stays English.
#
# Style: Vietnamese sentence case. Tone marks in the modern placement used by
# Microsoft and GNOME (hủy, thủy, hòa). No plural forms: pseudo-plurals such as
# "file(s)" become «{count} tệp». Quotation marks: “…”. Dashes: spaced em dash
# « — » between clauses, unspaced en dash in ranges («1–28»).
#
