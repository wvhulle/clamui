[Unit]
Description=Lazaret ClamAV admin service
Requires=lazaret-settings-merge.service
After=lazaret-settings-merge.service

[Service]
Type=dbus
BusName=page.codeberg.wvhulle.Lazaret.ClamavAdmin
ExecStart=@ADMIN_SERVICE_PATH@ serve
StateDirectory=lazaret
RuntimeDirectory=lazaret
RuntimeDirectoryPreserve=yes
ReadWritePaths=/var/lib/lazaret /run/lazaret -/var/lib/clamav
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
